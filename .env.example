# =============================================================================
# Gemini / Vertex AI configuration for the customize pipeline.
# Copy to `.env` and fill in real values. `.env` is gitignored; this template
# is committed so the active backend (Vertex vs Developer API) is identifiable
# in version control.
#
# Which backend is in use is decided by GOOGLE_GENAI_USE_VERTEXAI below
# (see src/lib/genai.ts -> createGenAI()).
# =============================================================================

# --- Gemini Developer API ---
# Used ONLY when GOOGLE_GENAI_USE_VERTEXAI is not "true". Get a key from
# https://aistudio.google.com/apikey
GEMINI_API_KEY=AIza...your-developer-api-key...

# --- Vertex AI backend (the toggle) ---
# Set to "true" to route every Gemini call through Vertex AI instead of the
# Developer API. Vertex auth uses Application Default Credentials (no API key):
#   gcloud auth application-default login \
#     --client-id-file=<oauth-client>.json \
#     --scopes=https://www.googleapis.com/auth/cloud-platform
# On a server, prefer a service account (GOOGLE_APPLICATION_CREDENTIALS) or a
# GCP-attached identity instead of user ADC.
#
# >>> PRODUCTION IS CURRENTLY RUNNING ON VERTEX (this value is "true"). <<<
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=wac-sales-pipeline
GOOGLE_CLOUD_LOCATION=us-central1

# --- Model IDs ---
# Vertex's catalog differs from the Developer API: the preview/alias IDs
# (gemini-3-flash-preview, gemini-2.0-flash, gemini-flash-latest) 404 in
# us-central1. The values below are verified working there. Remove them to
# fall back to the in-code Developer-API defaults when the toggle is "false".
GEMINI_TEXT_MODEL=gemini-2.5-flash
GEMINI_MODEL=gemini-2.5-flash,gemini-2.5-flash-lite
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# --- Optional ---
# Generate hero/scene images by default without passing --generate-hero.
# GENERATE_HERO_IMAGE=1
